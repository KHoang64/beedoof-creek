{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "headers": [
    {"source": "/Build/(.*)", "headers": [{"key":"Cache-Control","value":"no-cache"}]},
    {"source": "/Build/(.*).wasm.gz", "headers": [{"key":"Content-Type","value":"application/wasm"},{"key":"Content-Encoding","value":"gzip"}]},
    {"source": "/Build/(.*).js.gz", "headers": [{"key":"Content-Type","value":"application/javascript"},{"key":"Content-Encoding","value":"gzip"}]},
    {"source": "/Build/(.*).data.gz", "headers": [{"key":"Content-Type","value":"application/octet-stream"},{"key":"Content-Encoding","value":"gzip"}]},
    {"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"}]},
    {"source": "/", "headers": [{"key":"Cache-Control","value":"no-cache"}]},
    {"source": "/index.html", "headers": [{"key":"Cache-Control","value":"no-cache"}]}
  ]
}
